PROJECT_NAME="AgriSense AI Backend"
API_V1_STR="/api/v1"
SECRET_KEY="AGRISENSE_SECRET_KEY_SUPER_SECURE_JWT_TOKEN_KEY_CHANGE_IN_PRODUCTION"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM="HS256"

# Database Configuration (PostgreSQL by default, or SQLite for testing)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=agri_user
POSTGRES_PASSWORD=agri_password
POSTGRES_DB=agrisense_db
DATABASE_URL=postgresql+asyncpg://agri_user:agri_password@localhost:5432/agrisense_db

# File Storage Configuration ('local' or 's3')
STORAGE_TYPE=local
UPLOAD_DIR=uploads

# AI Provider Configuration ('gemini', 'openai', or 'mock')
AI_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=
VISION_MODEL=gemini-1.5-flash
SPEECH_MODEL=whisper-1
REASONING_MODEL=gemini-1.5-pro

# CORS Settings
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000"]
